{
  "name": "shopware-ai-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that proxies the ShopwareApp AI assistant to the Anthropic API, gated by an App Store subscription.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types:check": "wrangler types worker-configuration.d.ts --include-runtime false --env-file /dev/null --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "node-app-attest": "^1.0.1"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  }
}
